.env

# generated by cad/base.py
cad/*.stl
cad/to_print/*.stl

# build output / editor files
target/
.vscode/
.DS_Store

# what settings-tool moves between the lamp and the PC: these hold the Wi-Fi password
firmware_ws/wakecue/settings.text
firmware_ws/wakecue/settings-dump.bin
firmware_ws/wakecue/settings-sector.bin

# Vendor datasheets: large PDFs, re-downloadable (see docs/datasheets/*/README.md)
docs/datasheets/

# Audio for the lamp's microSD card: large, re-downloadable (see audio/README.md)
audio/
