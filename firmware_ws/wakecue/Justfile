# The lamp firmware. `just` builds and flashes it; `just monitor` reads the defmt
# log while the chip is awake (the port disappears the moment it sleeps).
set dotenv-load

bin := "target/riscv32imc-unknown-none-elf/release/wakecue"

# Build and flash. Plain `just` does this.
default: flash

# Compile the firmware for the chip.
build:
    cargo build --release

# Flash the release binary, then reset the chip with the watchdog.
flash: build
    espflash flash --chip esp32c3 --after watchdog-reset {{bin}}

# Read the four buttons and stay awake, with the log attached. `cargo run` flashes
# and monitors in one go and skips the extra reset that silences `espflash monitor`.
buttons:
    cargo run --release --bin buttons

# The lamp itself, flashed and watched. It sleeps a couple of seconds after boot, which
# takes the USB port with it, unless DEV_MODE at the top of src/bin/main.rs is true: then it
# stays awake and turns into a console for the buttons, the pad and the clock. A board that is
# asleep or in the bootloader cannot use this: `just flash` first, then this.
lamp:
    cargo run --release --bin wakecue

# Light the 16-pixel WS2812 ring on GPIO10: red, green, blue, then a 30 s ramp, on repeat.
ring:
    cargo run --release --bin ring

# Talk to the MP3 board over GPIO20/21: wait, set a low volume, ask how many files the card holds,
# play tracks 1 to 3, stop, repeat. Logs every byte the board sends back.
sound:
    cargo run --release --bin sound

# Does the MP3 board find a file by the number in its name or by its position? Plays track 22,
# file 0101 and file 0001 in turn and asks the board what it is playing. Needs /mp3/0101.mp3.
numbering:
    cargo run --release --bin numbering

# Read the defmt log while the chip is awake. Name the binary you flashed —
# `just monitor buttons`, or nothing for the lamp itself.
monitor name="wakecue":
    espflash monitor --chip esp32c3 -L defmt --elf target/riscv32imc-unknown-none-elf/release/{{name}}

# ---- settings from the PC, for a lamp whose menu is stuck or whose panel is dark ----
# The block is written by the same encoder the firmware reads, so this cannot drift from it.
# Each of these needs the board in download mode: hold BOOT, tap RST, release BOOT.

# Read both settings sectors (8 KB) off the lamp into settings-dump.bin.
settings-dump:
    espflash read-flash --chip esp32c3 0x9000 0x2000 settings-dump.bin

# Print what the lamp holds, in the same lines settings.text uses.
settings-show: settings-dump
    cd .. && cargo run -q -p wakecue-settings -- show --from wakecue/settings-dump.bin

# Turn settings.text into a sector image. With no settings.text yet, write one to edit.
# settings.text holds the Wi-Fi password: it is git-ignored on purpose.
settings-build:
    cd .. && cargo run -q -p wakecue-settings -- build --from wakecue/settings-dump.bin --text wakecue/settings.text --out wakecue/settings-sector.bin

# Erase sector A, write the image there and start the lamp on the new block.
settings-write:
    espflash erase-region --chip esp32c3 0x9000 0x1000 && espflash write-bin --chip esp32c3 --after watchdog-reset 0x9000 settings-sector.bin
