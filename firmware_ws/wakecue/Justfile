# The lamp firmware. `just` builds and flashes it; `just monitor` reads the defmt
# log while the chip is awake (the port disappears the moment it sleeps).

bin := "target/riscv32imc-unknown-none-elf/release/wakecue"

# Build and flash. Plain `just` does this.
default: flash

# Compile the firmware for the chip.
build:
    cargo build --release

# Flash the release binary, then reset the chip with the watchdog.
flash: build
    espflash flash --chip esp32c3 --after watchdog-reset {{bin}}

# Read the four buttons and stay awake, with the log attached. `cargo run` flashes
# and monitors in one go and skips the extra reset that silences `espflash monitor`.
buttons:
    cargo run --release --bin buttons

# The lamp itself, flashed and watched. Its boot takes seconds and then it sleeps,
# so the log ends there; the panel refreshing again is what shows the next wake.
lamp:
    cargo run --release --bin wakecue

# Read the defmt log while the chip is awake. Name the binary you flashed —
# `just monitor buttons`, or nothing for the lamp itself.
monitor name="wakecue":
    espflash monitor --chip esp32c3 -L defmt --elf target/riscv32imc-unknown-none-elf/release/{{name}}
